<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="conversation_message_macros" modification_key="mp_messenger_conv_classes" description="Add CSS classes and stylesheet for conversation messages" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<article class="message message--conversationMessage {{ $message.isIgnored() ? ' is-ignored' : '' }} {{ $message.isUnread($lastRead) ? 'is-unread' : '' }} js-message" data-author="{{ $message.User.username ?: $message.username }}">]]></find>
    <replace><![CDATA[<xf:css src="mp_messenger_conv.less" />
<article class="message message--conversationMessage {{ $message.isIgnored() ? ' is-ignored' : '' }} {{ $message.isUnread($lastRead) ? 'is-unread' : '' }} {{ $message.user_id == $xf.visitor.user_id ? 'mp-conversation-message--self ctaConversationMessageSelf' : 'mp-conversation-message--other ctaConversationMessageOther' }} js-message" data-author="{{ $message.User.username ?: $message.username }}">]]></replace>
  </modification>
  <modification type="public" template="conversation_view" modification_key="mp_messenger_conv_include_css" description="Include Messenger Conversations LESS styling" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title page="{$page}">{$conversation.title}</xf:title>]]></find>
    <replace><![CDATA[<xf:css src="mp_messenger_conv.less" />
<xf:title page="{$page}">{$conversation.title}</xf:title>]]></replace>
  </modification>
  <modification type="public" template="conversation_view" modification_key="mp_messenger_conv_sidebar_info" description="Add styling class to direct message info widget" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[	<div class="block">
		<div class="block-container">
			<h3 class="block-minorHeader">{{ phrase('direct_message_info') }}</h3>]]></find>
    <replace><![CDATA[	<div class="block mp-conversation-info ctaConversationInfo">
		<div class="block-container">
			<h3 class="block-minorHeader">{{ phrase('direct_message_info') }}</h3>]]></replace>
  </modification>
  <modification type="public" template="conversation_view" modification_key="mp_messenger_conv_sidebar_participants" description="Add styling class to direct message participants widget" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[	<div class="block">
		<div class="block-container">
			<h3 class="block-minorHeader">{{ phrase('direct_message_participants') }}</h3>]]></find>
    <replace><![CDATA[	<div class="block mp-conversation-participants ctaConversationParticipants">
		<div class="block-container">
			<h3 class="block-minorHeader">{{ phrase('direct_message_participants') }}</h3>]]></replace>
  </modification>
</template_modifications>
